{
  "name": "highlightjs-pkl",
  "version": "0.0.1",
  "description": "Highlight.js language definition for Pkl",
  "main": "src/pkl.js",
  "scripts": {
    "test": "jest",
    "build:grammar": "npx tsc --project tsconfig.json && node dist-scripts/convert-grammar.js pkl.tmbundle/Syntaxes/pkl.tmLanguage src/languages/pkl.js",
