    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.0",
    "@types/plist": "^3.0.5",
    "highlight.js": "^11.11.1",
    "jest": "^30.0.5",
    "markdownlint-cli2": "^0.18.1",
    "oniguruma-to-es": "^4.3.3",
    "plist": "^3.1.0",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "vscode-textmate": "^9.2.0"
  }
